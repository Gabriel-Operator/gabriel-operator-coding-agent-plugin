{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persona ontology v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceKey",
    "version",
    "name",
    "status",
    "entities",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resourceKey": {
      "type": "string",
      "pattern": "^ontology\\.persona\\.[a-z0-9][a-z0-9.-]{0,100}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "placeholder",
        "defined"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "entities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "attributes": {
            "type": "object",
            "maxProperties": 200,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "object",
                    "array",
                    "date",
                    "datetime"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "from",
          "to",
          "direction"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "direction": {
            "enum": [
              "directed",
              "undirected"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "cardinality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "to": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "minTargets": {
                "type": "integer",
                "minimum": 0
              },
              "maxTargets": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "primitives": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "Source"
      }
    }
  }
}
